/* ==================================================
   SERVICES IMAGE CARDS
================================================== */

.services-section,
.services-page-section {
    padding: 70px 0;
    background: #f8fafc;
}

.services-image-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
}

/* البطاقة */
.service-image-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;

    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;

    box-shadow: 0 7px 22px rgba(15, 23, 42, 0.06);

    transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
}

.service-image-card:hover {
    transform: translateY(-4px);
    border-color: #cbd5e1;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.11);
}

/* رابط الصورة */
.service-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
}

/* الصورة */
.service-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #eef2f7;
}

.service-image-wrapper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 0.35s ease;
}

.service-image-card:hover .service-image-wrapper img {
    transform: scale(1.04);
}

/* عند عدم وجود صورة */
.service-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    color: #94a3b8;
    font-size: 42px;

    background:
        linear-gradient(
            135deg,
            #f8fafc,
            #e8eef6
        );
}

/* الأيقونة الدائرية */
.service-floating-icon {
    position: absolute;
    right: 18px;
    bottom: 14px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 50px;
    height: 50px;

    color: var(--primary-color, #1455d9);
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #e2e8f0;
    border-radius: 50%;

    box-shadow: 0 5px 16px rgba(15, 23, 42, 0.14);
    font-size: 19px;
}

html[dir="rtl"] .service-floating-icon {
    right: auto;
    left: 18px;
}

/* محتوى البطاقة */
.service-image-content {
    display: flex;
    flex: 1;
    flex-direction: column;

    padding: 18px;
    text-align: start;
}

.service-title-link {
    display: block;
    color: inherit;
    text-decoration: none;
}

.service-title-link h3 {
    display: -webkit-box;
    margin: 0;

    color: #0f172a;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.45;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

/* التقييم */
.service-rating {
    display: flex;
    align-items: center;
    gap: 2px;

    margin-top: 8px;

    color: #f5a623;
    font-size: 15px;
    line-height: 1;
}

/* الوصف */
.service-image-content > p {
    display: -webkit-box;
    min-height: 46px;
    margin: 12px 0 18px;

    color: #64748b;
    font-size: 13px;
    line-height: 1.75;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

/* الأزرار */
.service-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    margin-top: auto;
}

.service-details-btn,
.service-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 9px 10px;

    border-radius: 9px;

    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;

    transition:
        color 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease;
}

.service-details-btn {
    color: var(--primary-color, #1455d9);
    background: #ffffff;
    border: 1px solid var(--primary-color, #1455d9);
}

.service-details-btn:hover {
    color: #ffffff;
    background: var(--primary-color, #1455d9);
}

.service-order-btn {
    color: #ffffff;
    background: var(--primary-color, #1455d9);
    border: 1px solid var(--primary-color, #1455d9);
}

.service-order-btn:hover {
    background: #0e43b1;
    border-color: #0e43b1;
}

/* رسالة عدم وجود خدمات */
.services-empty-message {
    grid-column: 1 / -1;
    padding: 35px 20px;
    text-align: center;
    color: #64748b;
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
}

/* ==================================================
   RESPONSIVE
================================================== */

@media (max-width: 1150px) {
    .services-image-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 820px) {
    .services-image-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
}

@media (max-width: 520px) {
    .services-section,
    .services-page-section {
        padding: 45px 0;
    }

    .services-image-grid {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .service-image-card {
        border-radius: 13px;
    }

    .service-image-content {
        padding: 15px;
    }

    .service-title-link h3 {
        font-size: 17px;
    }

    .service-card-actions {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .service-details-btn,
    .service-order-btn {
        min-height: 40px;
        padding: 8px;
        font-size: 12px;
    }
}