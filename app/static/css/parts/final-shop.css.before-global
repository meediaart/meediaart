/* ==================================================
   MODULE 03
   شريط تصنيفات المتجر الأفقي

   الملف المرتبط:
   app/templates/shop/index.html

   الوظيفة:
   - عرض التصنيفات أسفل البحث مباشرة.
   - جعل الشريط بعرض الشاشة كاملًا.
   - تمرير التصنيفات أفقيًا.
   - صور دائرية وأسماء واضحة.
   - تثبيت الشريط عند التمرير.

   لا يؤثر على:
   - المنتجات.
   - السلة.
   - المشاركة.
   - المفضلة.
================================================== */

.shop-category-strip {
    position: relative;
    z-index: 110;

    /*
    إخراج الشريط من عرض container
    وجعله بعرض الشاشة كاملًا.
    */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: 10px;
    margin-bottom: 10px;

    padding: 13px 0 10px;

    background: #ffffff;
    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
}

/*
عند تثبيت شريط التصنيفات
يأخذ عرض الشاشة كاملًا.
*/
.shop-category-strip.category-fixed {
    position: fixed;
    top: 70px;
    right: 0;
    left: 0;

    width: 100%;
    margin: 0;

    background: #ffffff;
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.08);
}

/* الحاوية الداخلية */
.shop-category-strip-inner {
    position: relative;

    display: flex;
    align-items: center;

    width: 100%;
    padding: 0 20px;
}

/* قائمة التصنيفات */
.shop-category-scroller {
    flex: 1;

    display: flex;
    align-items: flex-start;
    gap: 20px;

    width: 100%;
    min-width: 0;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 3px 8px 6px;

    scroll-behavior: smooth;
    scroll-snap-type: inline proximity;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;

    cursor: grab;
}

.shop-category-scroller::-webkit-scrollbar {
    display: none;
}

.shop-category-scroller.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
}

/* كل تصنيف */
.shop-category-pill {
    flex: 0 0 88px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;

    color: #222222;
    text-align: center;
    text-decoration: none;

    scroll-snap-align: start;
}

/* صورة التصنيف */
.shop-category-pill-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 74px;
    height: 74px;

    color: var(--primary-color, #1455d9);
    background: #f5f5f5;
    border: 2px solid transparent;
    border-radius: 50%;

    overflow: hidden;

    transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.shop-category-pill-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
}

.shop-category-pill-image i {
    font-size: 25px;
}

/* اسم التصنيف */
.shop-category-pill-name {
    overflow: hidden;

    width: 100%;

    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;

    text-overflow: ellipsis;
    white-space: nowrap;
}

/* الحركة عند المرور */
.shop-category-pill:hover .shop-category-pill-image {
    transform: translateY(-2px);
    border-color: var(--primary-color, #1455d9);
}

/* التصنيف النشط */
.shop-category-pill.active .shop-category-pill-image {
    border-color: var(--primary-color, #1455d9);
    box-shadow: 0 0 0 3px rgba(20, 85, 217, 0.1);
}

.shop-category-pill.active .shop-category-pill-name {
    color: var(--primary-color, #1455d9);
}

/* خط صغير تحت التصنيف النشط مثل التصميم المرجعي */
.shop-category-pill.active::after {
    content: "";

    width: 28px;
    height: 3px;

    margin-top: -2px;

    background: var(--primary-color, #1455d9);
    border-radius: 10px;
}

/* أسهم الكمبيوتر */
.shop-category-scroll-btn {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;
    padding: 0;

    color: #222222;
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 50%;

    cursor: pointer;

    transition:
        color 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease;
}

.shop-category-scroll-btn:hover {
    color: #ffffff;
    background: var(--primary-color, #1455d9);
    border-color: var(--primary-color, #1455d9);
}

.shop-category-scroll-start {
    margin-inline-end: 10px;
}

.shop-category-scroll-end {
    margin-inline-start: 10px;
}

