#shopProductsGrid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 20px;
    column-count: unset !important;
    column-gap: 20px;
    gap: 20px;
    align-items: start;
}

/* عنصر البطاقة */
#shopProductsGrid .shop-product-item {
    display: block !important;
    width: 100% !important;
    min-width: 0;
    height: auto;
    margin: 0 !important;
    padding: 0 !important;
    align-self: start;
}

#shopProductsGrid .shop-product-item[hidden] {
    display: none !important;
}

/* البطاقة */
#shopProductsGrid .product-card {
    position: relative;
    display: block;
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;

    background: #ffffff;
    border: 1px solid #e7e9ee;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;

    transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

#shopProductsGrid .product-card:hover {
    transform: translateY(-2px);
    border-color: #d3d8e2;
    box-shadow: 0 7px 20px rgba(0, 0, 0, 0.06);
}

/* =========================
   الصور على الكمبيوتر
========================= */

#shopProductsGrid .product-image-wrapper {
    position: relative;
    width: 100%;
    height: auto;
    margin: 0;
    overflow: hidden;
}

#shopProductsGrid .product-image-wrapper > a {
    display: block;
    width: 100%;
}

#shopProductsGrid .product-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1 !important;

    background: #f8f8f8;
    overflow: hidden;
}

#shopProductsGrid .product-img-main {
    display: block;
    width: 100%;
    height: 100% !important;
    max-width: 100%;
    object-fit: contain !important;
}

#shopProductsGrid .product-img-hover {
    position: absolute !important;
    inset: 0;
    display: block;
    width: 100%;
    height: 100% !important;
    object-fit: contain !important;
}

/* =========================
   محتوى البطاقة
========================= */

#shopProductsGrid .product-content {
    display: flex;
    flex-direction: column;
    gap: 2px !important;

    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    padding: 9px;
}

#shopProductsGrid .product-title-link {
    display: block;
    margin: 0 !important;
    color: inherit;
    text-decoration: none;
}

#shopProductsGrid .product-title-link h3 {
    display: -webkit-box;
    margin: 0 !important;

    font-size: 15px;
    line-height: 1.3;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

#shopProductsGrid .product-card-rating {
    margin: 0 !important;
    gap: 3px !important;
    line-height: 1;
}

#shopProductsGrid .product-content > p {
    display: -webkit-box;
    margin: 1px 0 0 !important;

    color: #737985;
    font-size: 12px;
    line-height: 1.35;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

/* السعر وزر السلة */
#shopProductsGrid .product-card-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6px;
    margin-top: 2px;
}

#shopProductsGrid .product-card-price-wrapper {
    flex: 1;
    min-width: 0;
}

#shopProductsGrid .price-box {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 !important;
    padding: 0;
}

#shopProductsGrid .price {
    font-weight: 700;
}

#shopProductsGrid .product-card-cart-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 36px;
    height: 36px;
    padding: 0;

    color: var(--primary-color, #1455d9);
    background: #ffffff;
    border: 1px solid #dce1e9;
    border-radius: 9px;
    cursor: pointer;

    transition:
        color 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease;
}

#shopProductsGrid .product-card-cart-btn:hover {
    color: #ffffff;
    background: var(--primary-color, #1455d9);
    border-color: var(--primary-color, #1455d9);
}

/* إخفاء اللون والمقاس والأزرار القديمة من البطاقة */
#shopProductsGrid .card-select-options,
#shopProductsGrid .product-actions {
    display: none !important;
}

/* =========================
   عدد الأعمدة
========================= */

@media (min-width: 1450px) {
    #shopProductsGrid {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }
}

@media (max-width: 1150px) {
    #shopProductsGrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
    }
}

/* =========================
   الجوال
========================= */

@media (max-width: 760px) {
    #shopProductsGrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 3px;
        gap: 7px;
    }

    #shopProductsGrid .product-card {
        border-radius: 9px;
        box-shadow: none;
    }

    #shopProductsGrid .product-card:hover {
        transform: none;
        box-shadow: none;
    }

    /* الصور بأبعادها الطبيعية على الجوال */
    #shopProductsGrid .product-image {
        display: block;
        width: 100%;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        aspect-ratio: auto !important;
    }

    #shopProductsGrid .product-img-main {
        position: relative !important;
        inset: auto !important;
        display: block;
        width: 100%;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        object-fit: contain !important;
    }

    #shopProductsGrid .product-img-hover {
        display: none !important;
    }

    #shopProductsGrid .product-content {
        gap: 1px !important;
        padding: 7px;
    }

    #shopProductsGrid .product-title-link h3 {
        font-size: 13px;
        line-height: 1.25;
    }

    #shopProductsGrid .product-card-rating {
        margin: 0 !important;
    }

    #shopProductsGrid .product-card-rating-stars span {
        font-size: 13px !important;
    }

    /* الوصف لا يظهر على الجوال */
    #shopProductsGrid .product-content > p {
        display: none;
    }

    #shopProductsGrid .price,
    #shopProductsGrid .discounted-price {
        font-size: 15px;
    }

    #shopProductsGrid .old-price {
        font-size: 11px;
    }

    #shopProductsGrid .product-card-cart-btn {
        width: 33px;
        height: 33px;
        border-radius: 8px;
    }
}

@media (max-width: 380px) {
    #shopProductsGrid {
        gap: 5px;
    }

    #shopProductsGrid .product-content {
        padding: 6px;
    }

    #shopProductsGrid .product-title-link h3 {
        font-size: 12px;
    }
}

#shopProductsGrid .product-card-cart-btn:disabled {
    cursor: wait;
    opacity: 0.7;
}

#shopProductsGrid .product-card-cart-btn.added {
    color: #ffffff;
    background: #20a05a;
    border-color: #20a05a;
}
/* ==================================================
   شريط الجوال في صف واحد
================================================== */

.shop-mobile-toolbar {
    display: flex;
    align-items: stretch;
    gap: 6px;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
}

.shop-mobile-toolbar::-webkit-scrollbar {
    display: none;
}

.shop-mobile-toolbar-btn {
    flex: 1 0 auto;
    min-width: max-content;
    white-space: nowrap;
}

.shop-mobile-reset-icon {
    flex: 0 0 42px;
    width: 42px;
    min-width: 42px;
    padding-inline: 0;
}

.shop-mobile-reset-icon i {
    margin: 0;
}

/* أقل وأعلى سعر بجوار بعضهما */
.shop-mobile-filters-sheet .shop-filters-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

/* ترتيب السعر بعرض كامل */
.shop-mobile-filters-sheet .shop-price-sort-group {
    grid-column: 1 / -1;
}

